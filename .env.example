# ==========================================
# Betsson Credentials (Never commit real .env)
# ==========================================

# Generic / Default account (used if market specific is not defined)
FUNDED_USER=
FUNDED_PASS=
EMPTY_USER=
EMPTY_PASS=

# Market specific accounts:
# betsson.com (English / EUR)
BETSSON_COM_FUNDED_USER=
BETSSON_COM_FUNDED_PASS=
BETSSON_COM_EMPTY_USER=
BETSSON_COM_EMPTY_PASS=

# betsson.pe (Spanish / PEN)
BETSSON_PE_FUNDED_USER=
BETSSON_PE_FUNDED_PASS=
BETSSON_PE_EMPTY_USER=
BETSSON_PE_EMPTY_PASS=

# Optional Proxy settings
# PROXY_SERVER=
# PROXY_USER=
# PROXY_PASS=

# Optional Game slug override
# GAME_SLUG=

# Use the real Google Chrome (recommended: the site rejects logins from the bundled Chromium)
PW_CHANNEL=chrome

# Headers agreed with Betsson to mark test traffic (JSON object, ask the mentors). Sent only to the Betsson domain.
# EXTRA_HTTP_HEADERS={"x-...":"..."}

# Run inside a browser you opened yourself (npm run browser) instead of a Playwright-launched one (recommended)
CDP_URL=http://127.0.0.1:9222
# BROWSER_PATH=

# ==========================================
# Betsson test accounts (copy to .env: cp .env.example .env)
# Passwords are NOT here: ask the team privately and fill them in your .env (never commit .env)
# ==========================================

# Account WITH balance (scenario 1, spin series, report demo)
FUNDED_USER=gaylord2026101591438339sz6i94nay4@betssongroup.com
FUNDED_PASS=

# Account WITHOUT balance (scenario 2: the spin must be blocked)
EMPTY_USER=kylie202610159354465330mvfmtkja@betssongroup.com
EMPTY_PASS=

# Brave driven over CDP (npm run browser:fresh opens it on this port). This project runs ONLY on Brave.
CDP_URL=http://127.0.0.1:9222
# Only if Brave is installed in a non-standard folder (must be the Brave executable)
# BRAVE_PATH=

# Pragmatic Play game to test (empty = first slot of the Pragmatic Play page)
GAME_SLUG=triple-hop-pots

# Headers agreed with Betsson to mark test traffic (JSON). Sent only to the Betsson domain.
EXTRA_HTTP_HEADERS={"x-obg-trusted-traffic":"1","x-obg-country-code":"ES","x-obg-origin":"ES","x-obg-internal":"1"}

# Optional proxy
# PROXY_SERVER=
# PROXY_USER=
# PROXY_PASS=
